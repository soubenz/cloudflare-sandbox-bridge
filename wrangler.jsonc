{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opalix-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.2 }
  },
  // One container class per lab family. Each family gets its own Dockerfile,
  // its own warm pool, and scales independently (spike risk R1).
  "containers": [
    {
      "class_name": "AgentLab",
      "image": "./images/agent/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10
    },
    {
      "class_name": "GatewayLab",
      "image": "./images/gateway/Dockerfile",
      // Custom instance type, not "standard-1": the gateway image's own
      // unpacked size outgrew standard-1's 8GB disk the moment Presidio +
      // spaCy were added (Module 7's PII-redaction lab) -- confirmed live
      // via `wrangler containers info`: every new instance failed
      // ImagePullError, "the requested disk size was smaller than the
      // unpacked size of the image", and the whole GatewayLab application
      // got stuck in `provisioning` with 0 healthy instances for hours,
      // taking down every gateway-family lab, not just the new one.
      // First attempt (0.5 vCPU, 4096 MiB, 16000 disk) was rejected by a
      // real deploy: Cloudflare requires custom instance types to have
      // >=1 vCPU (sub-1 vCPU is preset-only) and caps disk at 2x memory
      // in GiB. 16GB disk therefore needs at least 8 GiB memory, which
      // forces vCPU to 1 too -- more than the old 0.5/4096 (disk was the
      // only actual bottleneck), but still cheaper than jumping to the
      // standard-3 preset (2 vCPU, 8 GiB, 16GB disk), which would double
      // the vCPU for no reason. 16GB disk for real headroom given how
      // many tools this image has accumulated (pgvector, Qdrant, Phoenix,
      // MLflow, ContextForge, Jaeger, otelcol-contrib, Presidio) and is
      // likely to keep accumulating.
      "instance_type": { "vcpu": 1, "memory_mib": 8192, "disk_mb": 16000 },
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "AgentLab", "name": "AGENT_LAB" },
      { "class_name": "GatewayLab", "name": "GATEWAY_LAB" },
      { "class_name": "Pool", "name": "POOL" },
      { "class_name": "Session", "name": "SESSION" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentLab", "GatewayLab", "Pool", "Session"]
    }
  ],
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "opalix-backups" },
    { "binding": "LABS_BUCKET", "bucket_name": "opalix-labs" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "opalix", "database_id": "8af8d509-ceea-49b0-8ac5-b615a8907c54", "migrations_dir": "./migrations" }
  ],
  "vars": {
    // R2-backed backups need these even though BACKUP_BUCKET is already bound;
    // the SDK's createBackup() resolves account/bucket name independently of
    // the binding for presigned-URL mode. See docs/api.md.
    "BACKUP_BUCKET_NAME": "opalix-backups",
    "CLOUDFLARE_ACCOUNT_ID": "8f5baf938da8f184c5431050d65eef08",
    "LOCATION_HINT": "weur",
    // Every URL handed back to a client is built from this — urls.status,
    // urls.terminal, urls.events, urls.services, and {{session.base_url}}
    // in lab manifests. It must be a host that actually serves this
    // Worker: labs-api.opalix.ai is the intended custom domain but has no
    // DNS and no route here yet, so pointing at it handed clients URLs
    // that resolve nowhere. Change this in the same commit that attaches
    // the custom domain, not before.
    "PUBLIC_BASE_URL": "https://opalix-sandbox.soubenz94.workers.dev",
    "POOL_TARGET_AGENT": "1",
    "POOL_TARGET_GATEWAY": "1",
    // Time-of-day override of the targets above, UTC, first matching rule
    // wins; unset or unparseable falls back to POOL_TARGET_*. A warm gateway
    // slot is ~$108/month around the clock and ~$45 on this schedule.
    "POOL_SCHEDULE_AGENT": "mon-fri 06-20=1; *=0",
    "POOL_SCHEDULE_GATEWAY": "mon-fri 06-20=1; *=0",
    "LLM_HOST": "gateway.ai.cloudflare.com",
    "AI_GATEWAY_NAME": "opalix",
    // A small model on purpose: Workers AI text generation is capped at 300
    // requests/minute per ACCOUNT, and frontier models at 20. A cohort runs
    // labs concurrently, so a frontier model is demo-only. See docs/spike.md.
    "LLM_MODEL": "workers-ai/@cf/meta/llama-3.1-8b-instruct-fp8",
    "MIRROR_HOST": "mirror.opalix.ai",
    // The dashboard is its own Worker, so every browser call to this API is
    // cross-origin. Listed explicitly rather than "*": the list is visible
    // in config and changes without touching code.
    "DASHBOARD_ORIGIN": "https://opalix-dashboard.soubenz94.workers.dev,http://localhost:8788"
  },
  // Secrets (wrangler secret put): SANDBOX_API_KEY, SESSION_TOKEN_SECRET,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, AI_GATEWAY_TOKEN, ALERT_WEBHOOK_URL.
  // Optional: SANDBOX_API_KEY_PREVIOUS -- set only during a SANDBOX_API_KEY
  // rotation window; see docs/runbooks/secrets-rotation.md.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "preview_urls": false
}
