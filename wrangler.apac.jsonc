{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-sandbox-bridge-apac",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    // Enable distributed tracing so the bridge's custom spans
    // (bridge.<operation>) are recorded alongside automatic instrumentation.
    // Each span is annotated with the sandbox ID, container UUID, and
    // operation-specific metadata (command, file path, port, session, etc.).
    "traces": {
      "enabled": true,
      // Fraction of requests to trace (0.0–1.0). 1.0 traces everything; lower
      // it to reduce overhead and cost under high traffic.
      "head_sampling_rate": 1
    }
  },
  // The Sandbox Durable Object + its container image.
  // Bump the migration tag whenever new_sqlite_classes changes.
  "containers": [
    {
      "class_name": "Sandbox",
      // Pre-built image already pushed to Cloudflare's registry — no Docker
      // or build step needed at deploy time.
      "image": "registry.cloudflare.com/ac51d64c9b0b1b77b0bc834f635eafa4/cloudflare-sandbox-bridge-2-sandbox@sha256:d8511ef836cce3f4d841667db732025a2ecb32abbaf0d05e0c8be383ebbae6b3",
      // "standard-1" (4 vCPU / 8 GiB RAM) suits production workloads; drop to
      // "lite" to minimise cost when getting started.
      "instance_type": "standard-1",
      // Starting scale for this fresh APAC deployment — raise once validated.
      "max_instances": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "WarmPool",
        "name": "WarmPool"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["WarmPool"],
      "tag": "v2"
    }
  ],
  // Bind an R2 bucket named BACKUP_BUCKET to enable workspace snapshot
  // persistence via the backup API (optional — tar-over-HTTP works without it).
  // "r2_buckets": [
  //   { "binding": "BACKUP_BUCKET", "bucket_name": "cloudflare-sandbox-backups" }
  // ],
  // Cron trigger — primes the warm pool so the alarm loop starts on deploy.
  // Runs every minute by default. Remove or adjust if you only want manual
  // priming via POST /pool/prime.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Secrets — set via `wrangler secret put SANDBOX_API_KEY` before deploying.
  // The Python client must send this value as: Authorization: Bearer <token>
  // Declared here so wrangler generates the Env type; override in .dev.vars for local dev.
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    // Target number of pre-warmed containers (0 = disabled, no surprise bills).
    "WARM_POOL_TARGET": "1",
    // How often the pool alarm checks health and replenishes containers (ms).
    "WARM_POOL_REFRESH_INTERVAL": "10000",
    // Operator-declared instance ceiling. Set this to match
    // containers[].max_instances above so the pool knows its capacity without
    // crashing into the limit first. 0 = unknown (auto-learn from platform
    // errors). Note the effective warm ceiling is max_instances minus any
    // assigned containers, so warmTarget cannot equal max_instances while
    // sandboxes are in use.
    // Starting scale for this fresh APAC deployment — see PATCHES.md for why
    // raising or lowering this only takes effect with the configure() patch.
    "WARM_POOL_MAX_INSTANCES": "100",
    // Number of containers the pool starts in parallel per scale-up batch.
    // Higher fills the pool faster; too high risks the platform throttling a
    // cold-start stampede. Clamped to [1, 20]. Default 5.
    "WARM_POOL_SCALE_BATCH_SIZE": "5",
    // Not part of upstream @cloudflare/sandbox — only takes effect with the
    // getSandboxStub patch in PATCHES.md. Cloudflare Durable Object location
    // hint (best-effort, not a hard guarantee): wnam, enam, weur, eeur, apac,
    // apac-ne, apac-se, oc, sam, afr, me. Omit to fall back to
    // nearest-to-request placement.
    "SANDBOX_LOCATION_HINT": "apac"
  },
  "preview_urls": false
}
