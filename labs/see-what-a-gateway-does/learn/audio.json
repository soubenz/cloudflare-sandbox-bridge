  "clips": {
    "4e53f02ec2b8e2cc": {
      "voice": "atlas",
      "text": "Four teams, four providers, four keys.",
      "seconds": 3.02,
      "bytes": 18144
    },
    "73c907b0d24ba03c": {
      "voice": "thalia",
      "text": "Welcome to the museum. Key two is in a chat screenshot. Thumbs up, nobody saw the key.",
      "seconds": 6.5,
      "bytes": 39024
    },
    "7b21b0dba20f7410": {
      "voice": "luna",
      "text": "Three in the morning, the provider is down. Search's assistant works. Can't we switch?",
      "seconds": 4.94,
      "bytes": 29664
    },
    "b38be599f8d36dbd": {
      "voice": "orion",
      "text": "They renamed a model. Three apps had the old name in their code.",
      "seconds": 3.98,
      "bytes": 23904
    },
    "24aff5814ce374de": {
      "voice": "arcas",
      "text": "One bill a month. Which team spent it? Which provider answered? A shrug.",
      "seconds": 5.06,
      "bytes": 30384
    },
    "4db83407d42c754e": {
      "voice": "atlas",
      "text": "One loop, one weekend.",
      "seconds": 1.66,
      "bytes": 9936
    },
    "9a82f8a1ade4a039": {
      "voice": "orion",
      "text": "My prototype. One front door. It holds the keys and logs every call.",
      "seconds": 5.38,
      "bytes": 32256
    },
    "a0c601486f1e74ef": {
      "voice": "orion",
      "text": "It is meant to switch providers if one fails. Meant to.",
      "seconds": 4.82,
      "bytes": 28944
    },
    "a0e4c4f31f4b548c": {
      "voice": "thalia",
      "text": "So find out what it really does.",
      "seconds": 2.26,
      "bytes": 13536
    },
    "14cf90c0da3739d0": {
      "voice": "atlas",
      "text": "Your turn.",
      "seconds": 0.7,
      "bytes": 4176
    }
