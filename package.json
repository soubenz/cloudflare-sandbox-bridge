{
  "name": "opalix-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --containers-rollout=immediate",
    "build:dashboard": "node dashboard/build.mjs",
    "deploy:dashboard": "npm run build:dashboard && wrangler deploy --config dashboard/wrangler.jsonc",
    "dev:dashboard": "npm run build:dashboard && wrangler dev --config dashboard/wrangler.jsonc --port 8788",
    "deploy:staging": "wrangler deploy --env staging --containers-rollout=immediate",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "opalix": "tsx cli/src/index.ts",
    "d1:migrate": "wrangler d1 execute opalix --file=./migrations/0001_init.sql",
    "d1:migrate:staging": "wrangler d1 execute opalix --env staging --file=./migrations/0001_init.sql",
    "lab:publish": "tsx cli/src/index.ts labs publish",
    "typecheck:cli": "tsc --noEmit -p cli/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:cli"
  },
  "dependencies": {
    "hono": "^4.12.26",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "next",
    "@cloudflare/vitest-pool-workers": "^0.9.5",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "commander": "^13.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.102.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  }
}
