{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opalix-dashboard",
  "compatibility_date": "2026-09-22",

  // The console has a server side now. It holds SANDBOX_API_KEY and is the
  // only thing that may use it: the browser gets a session token and nothing
  // more. Everything except /auth/* and /api/* is still static, but the
  // Worker sees every request first so the password gate cannot be walked
  // around by asking for an asset directly.
  "main": "./dist-worker/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // A service binding, not an HTTPS call. A Worker cannot fetch another
  // Worker over workers.dev -- Cloudflare answers error 1042 -- and even
  // where it works it would leave the edge and come back. This dispatches
  // directly to the API Worker, so the request never becomes a public one.
  // The API still authenticates it: the key travels on the request as
  // before, and its router does not care how the request arrived.
  "services": [
    { "binding": "API", "service": "opalix-sandbox" }
  ],

  "vars": {
    // Only the path is used; the origin makes it a well-formed Request.
    "API_BASE": "https://opalix-sandbox.internal"
  }
  // Secrets (wrangler secret put --config dashboard/wrangler.jsonc):
  //   SANDBOX_API_KEY        the API's service key; never reaches the browser
  //   CONSOLE_PASSWORD       what the login page checks
  //   CONSOLE_COOKIE_SECRET  signs the session cookie
}
