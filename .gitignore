node_modules/
.dev.vars
.wrangler/
dist/
*.log
# ...but lab content is source, and a pasted log file is the most natural
# fixture a lab has: the whole point of forgotten-rules is that four pasted
# logs are worth more tokens than two hundred messages of chat. `*.log` had
# silently kept all six out of the repo, so a fresh clone got a case file that
# named attachments it did not have -- a lab with no bug left in it. Publish
# packs from the working tree, so this was invisible to anyone authoring on
# the machine that wrote them. test/unit/lab-content-tracked.test.ts is the
# fence: it fails if anything under labs/ is ignored.
!labs/**/*.log
.DS_Store
worker-configuration.d.ts

# Screenshots and report from the browser e2e run; regenerated on every run.
test/e2e/shots/

# Playwright run artifacts (traces, screenshots, error context) — regenerated
# on every run and large.
test-results/
playwright-report/

# Built by dashboard/build.mjs on deploy; not a source artifact.
dashboard/public/dist/

# Python bytecode. `labs/` holds Python lab content, and workspace/ is packed
# verbatim into the learner's container — shipping a previous author's stale
# .pyc files would shadow the .py sources a break-fix lab asks them to edit.
__pycache__/
*.pyc

# Built by dashboard/build.mjs; the Worker bundle, not a source artifact.
dashboard/dist-worker/
