node_modules/
.dev.vars
.wrangler/
dist/
*.log
.DS_Store
worker-configuration.d.ts

# Screenshots and report from the browser e2e run; regenerated on every run.
test/e2e/shots/

# Playwright run artifacts (traces, screenshots, error context) — regenerated
# on every run and large.
test-results/
playwright-report/

# Built by dashboard/build.mjs on deploy; not a source artifact.
dashboard/public/dist/

# Python bytecode. `labs/` holds Python lab content, and workspace/ is packed
# verbatim into the learner's container — shipping a previous author's stale
# .pyc files would shadow the .py sources a break-fix lab asks them to edit.
__pycache__/
*.pyc

# Built by dashboard/build.mjs; the Worker bundle, not a source artifact.
dashboard/dist-worker/
