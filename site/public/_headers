# Temporary: the site is served from workers.dev until opalix.ai points at
# Cloudflare. Keep that copy out of search results so it never competes with
# the real domain. Delete this rule when opalix.ai goes live.
/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://opalix-sandbox.soubenz94.workers.dev; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# Self-hosted fonts rarely change; let browsers keep them for 30 days.
/fonts/*
  Cache-Control: public, max-age=2592000
/design/fonts/*
  Cache-Control: public, max-age=2592000
